<Window x:Class="RecipeBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RecipeBook.Converters"
        mc:Ignorable="d"
        Title="Книга рецептов — Информационная система учёта кулинарных рецептов" 
        Height="720" Width="1180"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">

    <Window.Resources>
        <converters:CategoryToBackgroundConverter x:Key="CatBgConverter"/>
        <converters:CategoryToForegroundConverter x:Key="CatFgConverter"/>
        <converters:BooleanToFavoriteBrushConverter x:Key="FavBrushConverter"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E293B">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,24">
                    <TextBlock Text="КНИГА РЕЦЕПТОВ" FontSize="18" FontWeight="ExtraBold" Foreground="White"/>
                    <TextBlock Text="Персональная коллекция" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowAllCommand}">
                            <Grid>
                                <TextBlock Text="Все рецепты" VerticalAlignment="Center" FontWeight="Medium"/>
                                <Border Background="#3B82F6" CornerRadius="10" MinWidth="24" Height="20" 
                                        HorizontalAlignment="Right" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock Text="КАТЕГОРИИ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="14,14,0,6"/>

                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Супы">
                            <Grid>
                                <TextBlock Text="Супы" VerticalAlignment="Center"/>
                                <Border Background="#334155" CornerRadius="10" MinWidth="22" Height="20" HorizontalAlignment="Right" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SoupsCount}" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Салаты">
                            <Grid>
                                <TextBlock Text="Салаты" VerticalAlignment="Center"/>
                                <Border Background="#334155" CornerRadius="10" MinWidth="22" Height="20" HorizontalAlignment="Right" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SaladsCount}" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Основные блюда">
                            <Grid>
                                <TextBlock Text="Основные блюда" VerticalAlignment="Center"/>
                                <Border Background="#334155" CornerRadius="10" MinWidth="22" Height="20" HorizontalAlignment="Right" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MainDishesCount}" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Выпечка">
                            <Grid>
                                <TextBlock Text="Выпечка" VerticalAlignment="Center"/>
                                <Border Background="#334155" CornerRadius="10" MinWidth="22" Height="20" HorizontalAlignment="Right" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BakingCount}" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Десерты">
                            <Grid>
                                <TextBlock Text="Десерты" VerticalAlignment="Center"/>
                                <Border Background="#334155" CornerRadius="10" MinWidth="22" Height="20" HorizontalAlignment="Right" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DessertsCount}" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Напитки">
                            <Grid>
                                <TextBlock Text="Напитки" VerticalAlignment="Center"/>
                                <Border Background="#334155" CornerRadius="10" MinWidth="22" Height="20" HorizontalAlignment="Right" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BeveragesCount}" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Separator Background="#334155" Margin="8,14,8,14"/>

                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowFavoritesCommand}">
                            <Grid>
                                <TextBlock Text="Избранное" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Border Background="#EAB308" CornerRadius="10" MinWidth="24" Height="20" HorizontalAlignment="Right" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FavoritesCount}" Foreground="#0F172A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Бирюков И. И." FontWeight="Bold" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Пользователь (Кулинар)" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8"/>
                            <Button Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}"
                                    Height="28" Background="#334155" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand" FontSize="12">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Каталог рецептов" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="38" Padding="12,0" VerticalContentAlignment="Center" FontSize="13.5"
                         Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </TextBox.Resources>
                </TextBox>

                <ComboBox Grid.Column="2" ItemsSource="{Binding CategoriesFilterList}" 
                          SelectedItem="{Binding SelectedCategory}"
                          Height="38" VerticalContentAlignment="Center" FontSize="13"/>

                <Button Grid.Column="4" Content="Фильтры" Command="{Binding OpenFiltersCommand}" 
                        Height="38" Padding="16,0" Background="White" Foreground="#334155" BorderBrush="#CBD5E1" 
                        BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="6" Content="+ Создать рецепт" Command="{Binding CreateRecipeCommand}" 
                        Height="38" Padding="18,0" Background="#2563EB" Foreground="White" BorderThickness="0" 
                        Cursor="Hand" FontWeight="Bold" FontSize="13.5">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Recipes}" 
                          SelectedItem="{Binding SelectedRecipe}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="44"
                          HeadersVisibility="Column"
                          MouseDoubleClick="OnRecipeGridDoubleClick">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60" />

                        <DataGridTemplateColumn Header="Название блюда" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Категория" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Category, Converter={StaticResource CatBgConverter}}"
                                            CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" 
                                                   Foreground="{Binding Category, Converter={StaticResource CatFgConverter}}" 
                                                   FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Время" Binding="{Binding CookingTimeDisplay}" Width="90" />
                        <DataGridTextColumn Header="Порций" Binding="{Binding Servings}" Width="80" />
                        <DataGridTextColumn Header="Сложность" Binding="{Binding DifficultyShort}" Width="90" />

                        <DataGridTemplateColumn Header="Избранное" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="★ " Foreground="{Binding IsFavorite, Converter={StaticResource FavBrushConverter}}" FontSize="14"/>
                                        <TextBlock Text="{Binding FavoriteDisplay}" Foreground="#475569" FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Открыть рецепт" Command="{Binding ViewRecipeCommand}" Style="{StaticResource ActionSecondaryButton}"/>
                    <Button Content="Редактировать" Command="{Binding EditRecipeCommand}" Style="{StaticResource ActionSecondaryButton}"/>
                    <Button Content="Удалить" Command="{Binding DeleteRecipeCommand}" Style="{StaticResource ActionSecondaryButton}"/>
                    <Button Content="В избранное" Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource ActionSecondaryButton}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusText}" 
                           HorizontalAlignment="Right" VerticalAlignment="Center" 
                           Foreground="#64748B" FontSize="13" Margin="0,0,12,0"/>

                <!-- Пагинация (Предыдущая / Следующая страница) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&lt;" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanPrevPage}"
                            Width="32" Height="32" Margin="0,0,4,0" Background="White" Foreground="#334155"
                            BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="&gt;" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"
                            Width="32" Height="32" Background="White" Foreground="#334155"
                            BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
