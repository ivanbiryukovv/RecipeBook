<Window x:Class="RecipeBook.Views.AddEditRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RecipeBook.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowCaption}"
        Height="740" Width="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#F8FAFC">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:ImagePathToBitmapConverter x:Key="ImagePathConverter"/>
        
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,10">
            <TextBlock Text="{Binding WindowCaption}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Название блюда *" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource InputTextBoxStyle}"/>
                <TextBlock Text="{Binding TitleErrorMessage}" 
                           Foreground="#DC2626" FontSize="12" Margin="2,2,0,0"
                           Visibility="{Binding HasTitleError, Converter={StaticResource BoolToVisConverter}}"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Категория *" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SelectedCategory}" 
                                  Height="36" VerticalContentAlignment="Center" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Уровень сложности (1–5) *" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding DifficultyOptions}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding Difficulty}"
                                  Height="36" VerticalContentAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Время приготовления (мин) *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CookingTimeMinutes, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCookingTimeError}" Value="True">
                                            <Setter Property="BorderBrush" Value="#DC2626"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding CookingTimeErrorMessage}" 
                                   Foreground="#DC2626" FontSize="12" Margin="2,2,0,0"
                                   Visibility="{Binding HasCookingTimeError, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Количество порций *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Servings, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasServingsError}" Value="True">
                                            <Setter Property="BorderBrush" Value="#DC2626"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding ServingsErrorMessage}" 
                                   Foreground="#DC2626" FontSize="12" Margin="2,2,0,0"
                                   Visibility="{Binding HasServingsError, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Файл фотографии" Style="{StaticResource FieldLabelStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputTextBoxStyle}"/>
                    <Button Grid.Column="2" Content="Обзор..." Command="{Binding BrowseImageCommand}" 
                            Height="36" Background="#E2E8F0" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="SemiBold"/>
                </Grid>

                <Border Height="80" Width="140" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                        ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="Предпросмотр" Foreground="#94A3B8" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" 
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <TextBlock Text="Краткое описание блюда" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" TextWrapping="Wrap" Height="65" 
                         VerticalScrollBarVisibility="Auto" Style="{StaticResource InputTextBoxStyle}"/>

                <TextBlock Text="Состав ингредиентов" Style="{StaticResource FieldLabelStyle}"/>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewIngredientName, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="Название ингредиента" Height="30" Padding="4"/>
                            <TextBox Grid.Column="2" Text="{Binding NewIngredientQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="Количество" Height="30" Padding="4"/>
                            <TextBox Grid.Column="4" Text="{Binding NewIngredientUnit, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="Ед. изм. (г., шт., мл.)" Height="30" Padding="4"/>
                            <Button Grid.Column="6" Content="+ Добавить" Command="{Binding AddIngredientCommand}" 
                                    Height="30" Padding="10,0" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Ingredients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="4,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="#64748B" Margin="10,0,4,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Unit}" Foreground="#64748B"/>
                                            <Button Grid.Column="3" Content="✕" 
                                                    Command="{Binding DataContext.RemoveIngredientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#EF4444" 
                                                    FontWeight="Bold" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Пошаговый способ приготовления (каждый шаг с новой строки)" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding InstructionsText, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90" 
                         VerticalScrollBarVisibility="Auto" Style="{StaticResource InputTextBoxStyle}"/>

                <CheckBox Content="Добавить в избранное" IsChecked="{Binding IsFavorite}" 
                          Margin="0,12,0,0" FontSize="13" Foreground="#334155"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="* — обязательные поля для заполнения" 
                           VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Command="{Binding CancelCommand}" 
                            Width="90" Height="36" Margin="0,0,10,0" 
                            Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                            Width="110" Height="36" 
                            Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
