<Window x:Class="RecipeBook.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Фильтры каталога рецептов" 
        Height="470" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F8FAFC">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Фильтры каталога рецептов" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
        <TextBlock Grid.Row="1" Text="Отметьте критерии, которые необходимо учитывать при выборе." 
                   FontSize="13" Foreground="#64748B" Margin="0,4,0,20"/>

        <StackPanel Grid.Row="2">
            <!-- 1. Категория блюда -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Категория блюда" IsChecked="{Binding FilterByCategory}" 
                          VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                          IsEnabled="{Binding FilterByCategory}" Height="36" VerticalContentAlignment="Center" FontSize="13"/>
            </Grid>

            <!-- 2. Время приготовления -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Время приготовления" IsChecked="{Binding FilterByCookingTime}" 
                          VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155"/>
                <Grid Grid.Column="1" IsEnabled="{Binding FilterByCookingTime}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="от" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox Grid.Column="1" Text="{Binding MinCookingTime, UpdateSourceTrigger=PropertyChanged}" 
                             Height="36" VerticalContentAlignment="Center" Padding="8,0" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="до" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="#64748B"/>
                    <TextBox Grid.Column="3" Text="{Binding MaxCookingTime, UpdateSourceTrigger=PropertyChanged}" 
                             Height="36" VerticalContentAlignment="Center" Padding="8,0" FontSize="13"/>
                    <TextBlock Grid.Column="4" Text="минут" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#64748B"/>
                </Grid>
            </Grid>

            <!-- 3. Уровень сложности -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Уровень сложности" IsChecked="{Binding FilterByDifficulty}" 
                          VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding FilterByDifficulty}">
                    <CheckBox Content="1" IsChecked="{Binding Diff1}" Margin="0,0,16,0" FontSize="13"/>
                    <CheckBox Content="2" IsChecked="{Binding Diff2}" Margin="0,0,16,0" FontSize="13"/>
                    <CheckBox Content="3" IsChecked="{Binding Diff3}" Margin="0,0,16,0" FontSize="13"/>
                    <CheckBox Content="4" IsChecked="{Binding Diff4}" Margin="0,0,16,0" FontSize="13"/>
                    <CheckBox Content="5" IsChecked="{Binding Diff5}" Margin="0,0,0,0" FontSize="13"/>
                </StackPanel>
            </Grid>

            <!-- 4. Коллекция -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Коллекция" IsChecked="{Binding FilterByCollection}" 
                          VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155"/>
                <CheckBox Grid.Column="1" Content="Только рецепты из избранного" IsChecked="{Binding OnlyFavorites}" 
                          IsEnabled="{Binding FilterByCollection}" VerticalAlignment="Center" FontSize="13" Foreground="#475569"/>
            </Grid>

            <!-- 5. Количество порций -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Количество порций" IsChecked="{Binding FilterByServings}" 
                          VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Grid.Column="1" Text="{Binding Servings, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                         IsEnabled="{Binding FilterByServings}" Height="36" VerticalContentAlignment="Center" 
                         Padding="8,0" FontSize="13"/>
            </Grid>
        </StackPanel>

        <!-- Кнопки управления -->
        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сбросить фильтры" Command="{Binding ResetCommand}" 
                        Height="38" Padding="16,0" Margin="0,0,12,0"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="Применить фильтры" Command="{Binding ApplyCommand}" 
                        Height="38" Padding="18,0"
                        Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
