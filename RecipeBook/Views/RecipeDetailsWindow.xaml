<Window x:Class="RecipeBook.Views.RecipeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RecipeBook.Converters"
        mc:Ignorable="d"
        Title="Просмотр рецепта" 
        Height="740" Width="840"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#F8FAFC">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:BooleanToFavoriteBrushConverter x:Key="FavBrushConverter"/>
        <converters:ImagePathToBitmapConverter x:Key="ImagePathConverter"/>

        <Style x:Key="MetaCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0F172A">
                    <Run Text="Рецепт № "/>
                    <Run Text="{Binding Recipe.Id}"/>
                    <Run Text=". "/>
                    <Run Text="{Binding Recipe.Title}"/>
                </TextBlock>
                <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#64748B">
                    <Run Text="Дата добавления: "/>
                    <Run Text="{Binding Recipe.CreatedAt, StringFormat=dd.MM.yyyy}"/>
                    <Run Text=" | Автор: Бирюков И. И."/>
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="1" VerticalAlignment="Center" Background="#FEF3C7" CornerRadius="12" Padding="12,6"
                    Visibility="{Binding Recipe.IsFavorite, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="★ В избранном" Foreground="#D97706" FontWeight="Bold" FontSize="13"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>
                <!-- Изображение блюда / Превью баннер -->
                <Border Height="200" Background="#E2E8F0" CornerRadius="10" Margin="0,0,0,18" ClipToBounds="True">
                    <Grid>
                        <!-- Заглушка если фото нет или файл отсутствует -->
                        <Border Background="#1E293B">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🍽" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Recipe.Title}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Recipe.Category}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Реальное изображение при наличии файла на диске -->
                        <Image Source="{Binding Recipe.ImagePath, Converter={StaticResource ImagePathConverter}}" 
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Style="{StaticResource MetaCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Категория блюда" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Recipe.Category}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetaCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Время приготовления" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Recipe.CookingTimeDisplay}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetaCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Количество порций" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="Bold" Foreground="#1E293B">
                                <Run Text="{Binding Recipe.Servings}"/>
                                <Run Text=" персоны"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetaCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Уровень сложности" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Recipe.DifficultyDescription}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Краткое описание" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Recipe.Description}" FontSize="13.5" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,18" LineHeight="20"/>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Ингредиенты" FontSize="15" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Left"/>
                    <TextBlock FontSize="12" Foreground="#64748B" HorizontalAlignment="Right">
                        <Run Text="Всего: "/>
                        <Run Text="{Binding Recipe.Ingredients.Count, Mode=OneWay}"/>
                        <Run Text=" наим."/>
                    </TextBlock>
                </Grid>

                <DataGrid ItemsSource="{Binding Recipe.Ingredients}" AutoGenerateColumns="False" 
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" Background="White" BorderBrush="#CBD5E1" 
                          BorderThickness="1" RowHeight="32" Margin="0,0,0,20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование ингредиента" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="*" />
                        <DataGridTextColumn Header="Единица измерения" Binding="{Binding Unit}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Пошаговый способ приготовления" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Recipe.Instructions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13.5" Foreground="#334155" LineHeight="20"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
            <Grid>
                <Button Content="&lt; Назад к каталогу" Command="{Binding BackCommand}" 
                        HorizontalAlignment="Left" Width="150" Height="38" 
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Редактировать" Command="{Binding EditCommand}" 
                            Width="130" Height="38" Margin="0,0,10,0" 
                            Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="{Binding FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}" 
                            Width="170" Height="38" Margin="0,0,10,0" 
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Удалить рецепт" Command="{Binding DeleteCommand}" 
                            Width="130" Height="38" 
                            Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
